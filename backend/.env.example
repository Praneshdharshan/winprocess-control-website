# Copy this file to ".env" (same folder) and fill in the values before
# running the backend WITHOUT Docker. Docker Compose already sets these for you.

# --- Database (local MongoDB) ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=winprocess

# --- Allowed website origins for CORS (comma separated) ---
CORS_ORIGINS=http://localhost:3000

# --- Enquiry email (Emergent Managed Email) ---
# Needed only if you want the "Get in touch" form to actually send emails.
# Keep the placeholder to just run and browse the site without sending email.
EMERGENT_EMAIL_KEY=your-emergent-email-key
EMAIL_FROM_NAME=Win Process Control Engineering
EMAIL_REPLY_TO=you@example.com
OWNER_EMAIL=you@example.com
